<?xml version="1.0"?>
<launch>
  <group>
    <include file="$(find-pkg-share autoware_object_sorter)/launch/detected_object_sorter.launch.xml">
      <arg name="input/objects" value="/sensing/radar/detected_objects"/>
      <arg name="output/objects" value="sorted_objects"/>
      <arg name="param_path" value="$(find-pkg-share autoware_launch_config)/config/perception/object_recognition/detection/radar_filter/detected_object_sorter.param.yaml"/>
    </include>
  </group>

  <group>
    <include file="$(find-pkg-share autoware_detected_object_validation)/launch/object_lanelet_filter.launch.xml">
      <arg name="input/object" value="sorted_objects"/>
      <arg name="output/object" value="/perception/object_recognition/detection/radar/far_objects"/>
      <arg name="filtering_range_param" value="$(find-pkg-share autoware_launch_config)/config/perception/object_recognition/detection/object_filter/radar_lanelet_filter.param.yaml"/>
    </include>
  </group>
</launch>
