<?xml version="1.0"?>
<launch>
  <arg name="input_topic"/>
  <arg name="output_topic"/>
  <arg name="use_intra_process" default="true"/>
  <arg name="pointcloud_container_name" default="pointcloud_container"/>
  <arg name="use_pointcloud_map" default="true"/>

  <let name="down_sample_voxel_size" value="0.1"/>

  <!-- no-compare map pipeline -->
  <group unless="$(var use_pointcloud_map)">
    <load_composable_node target="$(var pointcloud_container_name)">
      <composable_node pkg="autoware_pointcloud_preprocessor" plugin="autoware::pointcloud_preprocessor::ApproximateDownsampleFilterComponent" name="voxel_grid_downsample_filter">
        <param name="voxel_size_x" value="$(var down_sample_voxel_size)"/>
        <param name="voxel_size_y" value="$(var down_sample_voxel_size)"/>
        <param name="voxel_size_z" value="$(var down_sample_voxel_size)"/>
        <remap from="input" to="$(var input_topic)"/>
        <remap from="output" to="$(var output_topic)"/>
        <extra_arg name="use_intra_process_comms" value="$(var use_intra_process)"/>
      </composable_node>
    </load_composable_node>
  </group>

  <!-- compare map pipeline -->
  <group if="$(var use_pointcloud_map)">
    <let name="down_sample_topic" value="/perception/obstacle_segmentation/pointcloud_map_filtered/downsampled/pointcloud"/>

    <load_composable_node target="$(var pointcloud_container_name)">
      <composable_node pkg="autoware_pointcloud_preprocessor" plugin="autoware::pointcloud_preprocessor::VoxelGridDownsampleFilterComponent" name="voxel_grid_downsample_filter">
        <param name="voxel_size_x" value="$(var down_sample_voxel_size)"/>
        <param name="voxel_size_y" value="$(var down_sample_voxel_size)"/>
        <param name="voxel_size_z" value="$(var down_sample_voxel_size)"/>
        <remap from="input" to="$(var input_topic)"/>
        <remap from="output" to="$(var down_sample_topic)"/>
        <extra_arg name="use_intra_process_comms" value="$(var use_intra_process)"/>
      </composable_node>
      <composable_node pkg="autoware_compare_map_segmentation" plugin="autoware::compare_map_segmentation::VoxelBasedCompareMapFilterComponent" name="voxel_based_compare_map_filter">
        <param from="$(find-pkg-share autoware_launch_config)/config/perception/object_recognition/detection/pointcloud_filter/pointcloud_map_filter.param.yaml" allow_substs="true"/>
        <param name="input_frame" value="map"/>
        <remap from="input" to="$(var down_sample_topic)"/>
        <remap from="map" to="/map/pointcloud_map"/>
        <remap from="output" to="$(var output_topic)"/>
        <remap from="map_loader_service" to="/map/get_differential_pointcloud_map"/>
        <remap from="kinematic_state" to="/localization/kinematic_state"/>
        <extra_arg name="use_intra_process_comms" value="false"/>
      </composable_node>
    </load_composable_node>
  </group>
</launch>
