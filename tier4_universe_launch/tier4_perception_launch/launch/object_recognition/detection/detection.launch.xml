<?xml version="1.0"?>
<launch>
  <arg name="lidar_detection_model_type">
    <choice value="bevfusion"/>
    <choice value="centerpoint"/>
    <choice value="pointpainting"/>
    <choice value="transfusion"/>
    <choice value="apollo"/>
    <choice value="clustering"/>
  </arg>
  <arg name="lidar_detection_model_name" description="options: `bevfusion_lidar`, `centerpoint`, `centerpoint_tiny`, `centerpoint_sigma`, `pointpainting`, `transfusion` (non-exhaustive)"/>

  <!-- Detector -->
  <group>
    <!-- Lidar dnn-based detectors-->
    <include file="$(find-pkg-share tier4_perception_launch)/launch/object_recognition/detection/detector/lidar_dnn_detector.launch.xml">
      <arg name="lidar_detection_model_type" value="$(var lidar_detection_model_type)"/>
      <arg name="lidar_detection_model_name" value="$(var lidar_detection_model_name)"/>
    </include>
  </group>
  <group>
    <!-- Lidar rule-based detectors-->
    <include file="$(find-pkg-share tier4_perception_launch)/launch/object_recognition/detection/detector/lidar_rule_detector.launch.xml">
      <arg name="lidar_detection_model_type" value="$(var lidar_detection_model_type)"/>
    </include>
  </group>
  <!-- DetectionByTracker -->
  <group>
    <push-ros-namespace namespace="detection_by_tracker"/>
    <include file="$(find-pkg-share autoware_detection_by_tracker)/launch/detection_by_tracker.launch.xml">
      <arg name="detection_by_tracker_param_path" value="$(find-pkg-share autoware_launch_config)/config/perception/object_recognition/detection/detection_by_tracker/detection_by_tracker.param.yaml"/>
      <arg name="input/initial_objects" value="/perception/object_recognition/detection/clustering/objects_with_feature"/>
      <arg name="input/tracked_objects" value="/perception/object_recognition/tracking/objects"/>
      <arg name="output" value="/perception/object_recognition/detection/detection_by_tracker/objects"/>
    </include>
  </group>

  <!-- Filter -->
  <group>
    <include file="$(find-pkg-share tier4_perception_launch)/launch/object_recognition/detection/filter/pointcloud_map_filter.launch.xml">
      <arg name="use_intra_process" value="true"/>
    </include>
  </group>

  <group>
    <include file="$(find-pkg-share autoware_detected_object_validation)/launch/obstacle_pointcloud_based_validator.launch.xml">
      <arg name="input/detected_objects" value="/perception/object_recognition/detection/$(var lidar_detection_model_type)/objects"/>
      <arg name="input/obstacle_pointcloud" value="/perception/object_recognition/detection/pointcloud_map_filtered/pointcloud"/>
      <arg name="output/objects" value="/perception/object_recognition/detection/$(var lidar_detection_model_type)/validation/objects"/>
      <arg
        name="obstacle_pointcloud_based_validator_param_path"
        value="$(find-pkg-share autoware_launch_config)/config/perception/object_recognition/detection/detected_object_validation/obstacle_pointcloud_based_validator.param.yaml"
      />
    </include>
  </group>

  <!-- Merger -->
  <group>
    <!-- Lidar object merger-->
    <include file="$(find-pkg-share tier4_perception_launch)/launch/object_recognition/detection/merger/lidar_merger.launch.xml">
      <arg name="lidar_detection_model_type" value="$(var lidar_detection_model_type)"/>
    </include>
  </group>
</launch>
