      <arg name="detection_rect" value="$(var tensorrt_yolox_ns)rois1"/>
      <arg name="tracked_rect" value="rois1"/>
      <arg name="enable_visualizer" value="$(var enable_visualizer)"/>
      <arg name="camera_index" value="1"/>
    </include>
  </group>

