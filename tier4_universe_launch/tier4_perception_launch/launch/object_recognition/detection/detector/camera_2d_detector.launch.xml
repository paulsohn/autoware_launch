<?xml version="1.0"?>
<launch>
  <!-- cspell: ignore semseg -->

  <arg name="data_path" default="$(env HOME)/autoware_data/ml_models"/>

  <arg name="image_number" default="1"/>
  <arg name="use_bytetrack" default="true" description="use bytetrack for tracking, if false, only detection is performed"/>
  <arg name="enable_visualizer" default="false"/>

  <arg name="tensorrt_yolox_ns" default=""/>
  <let name="tensorrt_yolox_ns" value="yolox/" if="$(var use_bytetrack)"/>

  <!-- options: `yolox-sPlus-T4-960x960-pseudo-finetune.onnx` if only detection is needed, `yolox-sPlus-opt-pseudoV2-T4-960x960-T4-seg16cls.onnx` if sematic segmentation is also needed -->
  <let name="camera_2d_detector/model_path" value="$(var data_path)/tensorrt_yolox/yolox-sPlus-opt-pseudoV2-T4-960x960-T4-seg16cls.onnx"/>
  <let name="camera_2d_detector/label_path" value="$(var data_path)/tensorrt_yolox/label.txt"/>
  <let name="camera_2d_detector/color_map_path" value="$(var data_path)/tensorrt_yolox/semseg_color_map.csv"/>
  <let name="camera_2d_detector/roi_remap_path" value="$(find-pkg-share autoware_launch_config)/config/perception/traffic_light_recognition/tensorrt_yolox/roi_label_remap.csv"/>
  <let name="camera_2d_detector/roi_to_semseg_remap_path" value="$(find-pkg-share autoware_launch_config)/config/perception/traffic_light_recognition/tensorrt_yolox/roi_to_semseg_label_remap.csv"/>

  <group if="$(eval &quot;$(var image_number)>=1&quot;)">
    <include file="$(find-pkg-share autoware_tensorrt_yolox)/launch/yolox.launch.xml">
      <arg name="yolox_node_name" value="tensorrt_yolox0"/>
      <arg name="image_transport_decompressor_node_name" value="image_transport_decompressor_node0"/>
      <arg name="input/image" value="/sensing/camera/camera0/image_raw"/>
      <arg name="output/objects" value="$(var tensorrt_yolox_ns)rois0"/>
      <arg name="model_path" value="$(var camera_2d_detector/model_path)"/>
      <arg name="label_path" value="$(var camera_2d_detector/label_path)"/>
      <arg name="semantic_segmentation_color_map_path" value="$(var camera_2d_detector/color_map_path)"/>
      <arg name="roi_remap_path" value="$(var camera_2d_detector/roi_remap_path)"/>
      <arg name="roi_to_semantic_segmentation_remap_path" value="$(var camera_2d_detector/roi_to_semseg_remap_path)"/>
    </include>

    <include file="$(find-pkg-share autoware_bytetrack)/launch/bytetrack.launch.xml" if="$(var use_bytetrack)">
      <arg name="in_image" value="/sensing/camera/camera0/image_raw"/>
      <arg name="detection_rect" value="$(var tensorrt_yolox_ns)rois0"/>
      <arg name="tracked_rect" value="rois0"/>
      <arg name="enable_visualizer" value="$(var enable_visualizer)"/>
      <arg name="camera_index" value="0"/>
    </include>
  </group>

  <group if="$(eval &quot;$(var image_number)>=2&quot;)">
