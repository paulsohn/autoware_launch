      <arg name="input/image" value="/sensing/camera/camera1/image_raw"/>
      <arg name="output/objects" value="$(var tensorrt_yolox_ns)rois1"/>
      <arg name="model_path" value="$(var camera_2d_detector/model_path)"/>
      <arg name="label_path" value="$(var camera_2d_detector/label_path)"/>
      <arg name="semantic_segmentation_color_map_path" value="$(var camera_2d_detector/color_map_path)"/>
