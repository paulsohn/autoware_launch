<?xml version="1.0"?>
<launch>
  <!-- Camera numbers should be at least 6 -->
  <arg name="output/objects"/>

  <!-- Model parameters -->
  <arg name="data_path" default="$(env HOME)/autoware_data/ml_models" description="packages data and artifacts directory path"/>
  <arg name="bevdet_model_name" default="bevdet_one_lt_d"/>
  <arg name="bevdet_model_path" default="$(var data_path)/tensorrt_bevdet"/>
  <!-- BEVDet -->
  <group>
    <push-ros-namespace namespace="bevdet"/>
    <include file="$(find-pkg-share autoware_tensorrt_bevdet)/launch/tensorrt_bevdet.launch.xml">
      <arg name="input/img_front_left" value="/sensing/camera/camera0/image_raw"/>
      <arg name="input/img_front_left/camera_info" value="/sensing/camera/camera0/camera_info"/>
      <arg name="input/img_front" value="/sensing/camera/camera1/image_raw"/>
      <arg name="input/img_front/camera_info" value="/sensing/camera/camera1/camera_info"/>
      <arg name="input/img_front_right" value="/sensing/camera/camera2/image_raw"/>
      <arg name="input/img_front_right/camera_info" value="/sensing/camera/camera2/camera_info"/>
      <arg name="input/img_back_left" value="/sensing/camera/camera3/image_raw"/>
      <arg name="input/img_back_left/camera_info" value="/sensing/camera/camera3/camera_info"/>
      <arg name="input/img_back" value="/sensing/camera/camera4/image_raw"/>
      <arg name="input/img_back/camera_info" value="/sensing/camera/camera4/camera_info"/>
      <arg name="input/img_back_right" value="/sensing/camera/camera5/image_raw"/>
      <arg name="input/img_back_right/camera_info" value="/sensing/camera/camera5/camera_info"/>
      <arg name="output/boxes" value="$(var output/objects)"/>
      <arg name="data_path" value="$(var data_path)"/>
      <arg name="model_name" value="$(var bevdet_model_name)"/>
      <arg name="model_path" value="$(var bevdet_model_path)"/>
    </include>
  </group>
</launch>
