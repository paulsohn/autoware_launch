<?xml version="1.0"?>
<launch>
  <!-- Lidar + Camera detector parameters -->
  <arg name="lidar_detection_model_type">
    <choice value="bevfusion"/>
    <choice value="centerpoint"/>
    <choice value="pointpainting"/>
    <choice value="transfusion"/>
    <choice value="apollo"/>
    <choice value="clustering"/>
  </arg>
  <arg name="lidar_detection_model_name" description="options: `bevfusion_lidar`, `centerpoint`, `centerpoint_tiny`, `centerpoint_sigma`, `pointpainting`, `transfusion` (non-exhaustive)"/>

  <include file="$(find-pkg-share autoware_agnocast_wrapper)/launch/agnocast_env.launch.xml"/>

  <!-- PointPainting -->
  <group if="$(eval &quot;'$(var lidar_detection_model_type)'=='pointpainting'&quot;)">
    <push-ros-namespace namespace="pointpainting"/>
    <include file="$(find-pkg-share autoware_image_projection_based_fusion)/launch/pointpainting_fusion.launch.xml">
      <arg name="input/rois_number" value="6"/>
      <arg name="input/rois0" value="/perception/object_recognition/detection/rois0"/>
      <arg name="input/rois1" value="/perception/object_recognition/detection/rois1"/>
      <arg name="input/rois2" value="/perception/object_recognition/detection/rois2"/>
      <arg name="input/rois3" value="/perception/object_recognition/detection/rois3"/>
      <arg name="input/rois4" value="/perception/object_recognition/detection/rois4"/>
      <arg name="input/rois5" value="/perception/object_recognition/detection/rois5"/>
      <arg name="input/camera_info0" value="/sensing/camera/camera0/camera_info"/>
      <arg name="input/camera_info1" value="/sensing/camera/camera1/camera_info"/>
      <arg name="input/camera_info2" value="/sensing/camera/camera2/camera_info"/>
      <arg name="input/camera_info3" value="/sensing/camera/camera3/camera_info"/>
      <arg name="input/camera_info4" value="/sensing/camera/camera4/camera_info"/>
      <arg name="input/camera_info5" value="/sensing/camera/camera5/camera_info"/>
      <arg name="input/image0" value="/sensing/camera/camera0/image_raw"/>
      <arg name="input/image1" value="/sensing/camera/camera1/image_raw"/>
      <arg name="input/image2" value="/sensing/camera/camera2/image_raw"/>
      <arg name="input/image3" value="/sensing/camera/camera3/image_raw"/>
      <arg name="input/image4" value="/sensing/camera/camera4/image_raw"/>
      <arg name="input/image5" value="/sensing/camera/camera5/image_raw"/>
      <arg name="input/pointcloud" value="/sensing/lidar/concatenated/pointcloud"/>
      <arg name="input/concatenation_info" value="/sensing/lidar/concatenated/pointcloud_info"/>
      <arg name="output/objects" value="/perception/object_recognition/detection/$(var lidar_detection_model_type)/objects"/>

      <arg name="model_name" value="$(var lidar_detection_model_name)"/>
      <arg name="model_path" value="$(var data_path)/image_projection_based_fusion"/>
      <arg name="model_param_path" value="$(find-pkg-share autoware_launch_config)/config/perception/object_recognition/detection/lidar_model/$(var lidar_detection_model_name).param.yaml"/>
      <arg name="ml_package_param_path" value="$(var model_path)/$(var lidar_detection_model_name)_ml_package.param.yaml"/>
      <arg name="class_remapper_param_path" value="$(var model_path)/detection_class_remapper.param.yaml"/>
      <arg name="common_param_path" value="$(find-pkg-share autoware_launch_config)/config/perception/object_recognition/detection/image_projection_based_fusion/pointpainting_common.param.yaml"/>
      <arg name="use_pointcloud_container" value="true"/>
      <arg name="pointcloud_container_name" value="/pointcloud_container"/>
    </include>
  </group>

  <!-- Clustering -->
  <group>
    <push-ros-namespace namespace="clustering"/>
    <group>
      <include file="$(find-pkg-share autoware_euclidean_cluster)/launch/voxel_grid_based_euclidean_cluster.launch.xml">
        <arg name="input_pointcloud" value="/perception/object_recognition/detection/pointcloud_map_filtered/pointcloud"/>
        <arg name="output_clusters" value="/perception/object_recognition/detection/clustering/clusters"/>
        <arg name="use_low_height_cropbox" value="false"/>
        <arg name="use_pointcloud_container" value="false"/>
        <arg
          name="voxel_grid_based_euclidean_param_path"
          value="$(find-pkg-share autoware_launch_config)/config/perception/object_recognition/detection/clustering/voxel_grid_based_euclidean_cluster.param.yaml"
        />
      </include>
    </group>

    <!-- shape_estimation 1 -->
    <node pkg="autoware_shape_estimation" exec="shape_estimation_node" name="shape_estimation" output="screen">
      <env name="LD_PRELOAD" value="$(var ld_preload_value)"/>
      <remap from="input" to="/perception/object_recognition/detection/clustering/clusters"/>
      <remap from="objects" to="/perception/object_recognition/detection/clustering/objects_with_feature"/>
      <param name="model_path" value="$(var data_path)/shape_estimation/pointnet.onnx"/>
      <param from="$(find-pkg-share autoware_shape_estimation)/config/shape_estimation.param.yaml" allow_substs="true"/>
    </node>

    <group>
      <push-ros-namespace namespace="camera_lidar_fusion"/>
      <!-- Fusion camera-lidar to classify -->

      <!-- euclidean clustering -->
      <group>
        <include file="$(find-pkg-share autoware_image_projection_based_fusion)/launch/roi_cluster_fusion.launch.xml">
          <arg name="input/rois_number" value="6"/>
          <arg name="input/rois0" value="/perception/object_recognition/detection/rois0"/>
          <arg name="input/rois1" value="/perception/object_recognition/detection/rois1"/>
          <arg name="input/rois2" value="/perception/object_recognition/detection/rois2"/>
          <arg name="input/rois3" value="/perception/object_recognition/detection/rois3"/>
          <arg name="input/rois4" value="/perception/object_recognition/detection/rois4"/>
          <arg name="input/rois5" value="/perception/object_recognition/detection/rois5"/>
          <arg name="input/camera_info0" value="/sensing/camera/camera0/camera_info"/>
          <arg name="input/camera_info1" value="/sensing/camera/camera1/camera_info"/>
          <arg name="input/camera_info2" value="/sensing/camera/camera2/camera_info"/>
          <arg name="input/camera_info3" value="/sensing/camera/camera3/camera_info"/>
          <arg name="input/camera_info4" value="/sensing/camera/camera4/camera_info"/>
          <arg name="input/camera_info5" value="/sensing/camera/camera5/camera_info"/>
          <arg name="input/image0" value="/sensing/camera/camera0/image_raw"/>
          <arg name="input/image1" value="/sensing/camera/camera1/image_raw"/>
          <arg name="input/image2" value="/sensing/camera/camera2/image_raw"/>
          <arg name="input/image3" value="/sensing/camera/camera3/image_raw"/>
          <arg name="input/image4" value="/sensing/camera/camera4/image_raw"/>
          <arg name="input/image5" value="/sensing/camera/camera5/image_raw"/>
          <arg name="input/concatenation_info" value="/sensing/lidar/concatenated/pointcloud_info"/>
          <arg name="input/clusters" value="/perception/object_recognition/detection/clustering/clusters"/>
          <arg name="output/clusters" value="/perception/object_recognition/detection/clustering/camera_lidar_fusion/clusters"/>
          <arg name="param_path" value="$(find-pkg-share autoware_launch_config)/config/perception/object_recognition/detection/image_projection_based_fusion/roi_cluster_fusion.param.yaml"/>
        </include>
      </group>

      <!-- low_intensity_cluster_filter -->
      <node pkg="autoware_raindrop_cluster_filter" exec="low_intensity_cluster_filter_node" name="low_intensity_cluster_filter_node" output="screen">
        <env name="LD_PRELOAD" value="$(var ld_preload_value)"/>
        <remap from="input/objects" to="/perception/object_recognition/detection/clustering/camera_lidar_fusion/clusters"/>
        <remap from="output/objects" to="/perception/object_recognition/detection/clustering/camera_lidar_fusion/filtered/clusters"/>
        <param name="input_obstacle_pointcloud" value="false"/>
        <param from="$(find-pkg-share autoware_raindrop_cluster_filter)/config/low_intensity_cluster_filter.param.yaml"/>
      </node>

      <node pkg="autoware_shape_estimation" exec="shape_estimation_node" name="shape_estimation" output="screen">
        <env name="LD_PRELOAD" value="$(var ld_preload_value)"/>
        <remap from="input" to="/perception/object_recognition/detection/clustering/camera_lidar_fusion/filtered/clusters"/>
        <remap from="objects" to="/perception/object_recognition/detection/clustering/camera_lidar_fusion/objects_with_feature"/>
        <param name="model_path" value="$(var data_path)/shape_estimation/pointnet.onnx"/>
        <param from="$(find-pkg-share autoware_shape_estimation)/config/shape_estimation.param.yaml" allow_substs="true"/>
      </node>

      <!-- convert DynamicObjectsWithFeatureArray to DynamicObjects -->
      <node pkg="autoware_detected_object_feature_remover" exec="detected_object_feature_remover_node" name="detected_object_feature_remover" output="screen">
        <env name="LD_PRELOAD" value="$(var ld_preload_value)"/>
        <remap from="~/input" to="/perception/object_recognition/detection/clustering/camera_lidar_fusion/objects_with_feature"/>
        <remap from="~/output" to="/perception/object_recognition/detection/clustering/camera_lidar_fusion/unfiltered/objects"/>
        <param name="run_convex_hull_conversion" value="false"/>
      </node>
    </group>
  </group>
</launch>
