<?xml version="1.0"?>
<launch>
  <!-- Lidar + Camera detector parameters -->
  <arg name="lidar_detection_model_type">
    <choice value="bevfusion"/>
    <choice value="centerpoint"/>
    <choice value="pointpainting"/>
    <choice value="transfusion"/>
    <choice value="apollo"/>
    <choice value="clustering"/>
  </arg>
  <arg name="lidar_detection_model_name" description="options: `bevfusion_lidar`, `centerpoint`, `centerpoint_tiny`, `centerpoint_sigma`, `pointpainting`, `transfusion` (non-exhaustive)"/>
  <arg name="use_low_intensity_cluster_filter"/>
  <arg name="use_image_segmentation_based_filter"/>

  <!-- External interfaces -->
  <arg name="number_of_cameras"/>

  <arg name="input/pointcloud"/>
  <arg name="input/pointcloud_map/pointcloud"/>

  <arg name="output/ml_detector/objects"/>
  <arg name="output/rule_detector/objects"/>
  <arg name="output/clustering/cluster_objects"/>

  <!-- Internal interfaces -->
  <let name="pointpainting/input/pointcloud" value="$(var input/pointcloud)"/>
  <let name="pointpainting/output/objects" value="$(var output/ml_detector/objects)"/>

  <let name="segmentation_based_filtered/input/pointcloud" value="$(var input/pointcloud_map/pointcloud)"/>
  <let name="segmentation_based_filtered/output/pointcloud" value="/perception/object_recognition/detection/segmentation_based_filtered/pointcloud"/>

  <let name="euclidean_cluster/input/pointcloud" value="$(var segmentation_based_filtered/output/pointcloud)" if="$(var use_image_segmentation_based_filter)"/>
  <let name="euclidean_cluster/input/pointcloud" value="$(var input/pointcloud_map/pointcloud)" unless="$(var use_image_segmentation_based_filter)"/>
  <let name="euclidean_cluster/output/clusters" value="/perception/object_recognition/detection/clustering/clusters"/>
  <let name="shape_estimation1/input/clusters" value="$(var euclidean_cluster/output/clusters)"/>
  <let name="shape_estimation1/output/objects" value="$(var output/clustering/cluster_objects)"/>

  <let name="roi_cluster_fusion/input/clusters" value="$(var euclidean_cluster/output/clusters)"/>
  <let name="roi_cluster_fusion/output/clusters" value="/perception/object_recognition/detection/clustering/camera_lidar_fusion/clusters"/>
  <let name="low_intensity_cluster_filter/input/clusters" value="$(var roi_cluster_fusion/output/clusters)"/>
  <let name="low_intensity_cluster_filter/output/clusters" value="/perception/object_recognition/detection/clustering/camera_lidar_fusion/filtered/clusters"/>

  <let name="shape_estimation2/input/clusters" value="$(var roi_cluster_fusion/output/clusters)" unless="$(var use_low_intensity_cluster_filter)"/>
  <let name="shape_estimation2/input/clusters" value="$(var low_intensity_cluster_filter/output/clusters)" if="$(var use_low_intensity_cluster_filter)"/>
  <let name="shape_estimation2/output/objects" value="/perception/object_recognition/detection/clustering/camera_lidar_fusion/objects_with_feature"/>
  <let name="detected_object_feature_remover/input/objects_with_feature" value="$(var shape_estimation2/output/objects)"/>
  <let name="detected_object_feature_remover/output/objects" value="$(var output/rule_detector/objects)"/>

  <arg name="enable_2d_detection" default="false" description="true: when 2d detection yolox model run the same machine, false: when it run in separate machine"/>

  <include file="$(find-pkg-share autoware_agnocast_wrapper)/launch/agnocast_env.launch.xml"/>

  <include file="$(find-pkg-share tier4_perception_launch)/launch/object_recognition/detection/detector/camera_2d_detector.launch.xml" if="$(var enable_2d_detection)">
    <arg name="image_raw0" value="/sensing/camera/camera0/image_raw"/>
    <arg name="image_raw1" value="/sensing/camera/camera1/image_raw"/>
    <arg name="image_raw2" value="/sensing/camera/camera2/image_raw"/>
    <arg name="image_raw3" value="/sensing/camera/camera3/image_raw"/>
    <arg name="image_raw4" value="/sensing/camera/camera4/image_raw"/>
    <arg name="image_raw5" value="/sensing/camera/camera5/image_raw"/>
    <arg name="image_raw6" value="/sensing/camera/camera6/image_raw"/>
    <arg name="image_raw7" value="/sensing/camera/camera7/image_raw"/>
    <arg name="image_number" value="$(var number_of_cameras)"/>
  </include>

  <!-- PointPainting -->
  <group if="$(eval &quot;'$(var lidar_detection_model_type)'=='pointpainting'&quot;)">
    <let name="lidar_detection_model_name" value="$(eval &quot;'pointpainting' if ''=='$(var lidar_detection_model_name)' else '$(var lidar_detection_model_name)'&quot;)"/>
    <push-ros-namespace namespace="pointpainting"/>
    <include file="$(find-pkg-share autoware_image_projection_based_fusion)/launch/pointpainting_fusion.launch.xml">
      <arg name="input/rois_number" value="$(var number_of_cameras)"/>
      <arg name="input/rois0" value="/perception/object_recognition/detection/rois0"/>
      <arg name="input/rois1" value="/perception/object_recognition/detection/rois1"/>
      <arg name="input/rois2" value="/perception/object_recognition/detection/rois2"/>
      <arg name="input/rois3" value="/perception/object_recognition/detection/rois3"/>
      <arg name="input/rois4" value="/perception/object_recognition/detection/rois4"/>
      <arg name="input/rois5" value="/perception/object_recognition/detection/rois5"/>
      <arg name="input/rois6" value="/perception/object_recognition/detection/rois6"/>
      <arg name="input/rois7" value="/perception/object_recognition/detection/rois7"/>
      <arg name="input/rois8" value="/perception/object_recognition/detection/rois8"/>
      <arg name="input/camera_info0" value="/sensing/camera/camera0/camera_info"/>
      <arg name="input/camera_info1" value="/sensing/camera/camera1/camera_info"/>
      <arg name="input/camera_info2" value="/sensing/camera/camera2/camera_info"/>
      <arg name="input/camera_info3" value="/sensing/camera/camera3/camera_info"/>
      <arg name="input/camera_info4" value="/sensing/camera/camera4/camera_info"/>
      <arg name="input/camera_info5" value="/sensing/camera/camera5/camera_info"/>
      <arg name="input/camera_info6" value="/sensing/camera/camera6/camera_info"/>
      <arg name="input/camera_info7" value="/sensing/camera/camera7/camera_info"/>
      <arg name="input/camera_info8" value="/sensing/camera/camera8/camera_info"/>
      <arg name="input/image0" value="/sensing/camera/camera0/image_raw"/>
      <arg name="input/image1" value="/sensing/camera/camera1/image_raw"/>
      <arg name="input/image2" value="/sensing/camera/camera2/image_raw"/>
      <arg name="input/image3" value="/sensing/camera/camera3/image_raw"/>
      <arg name="input/image4" value="/sensing/camera/camera4/image_raw"/>
      <arg name="input/image5" value="/sensing/camera/camera5/image_raw"/>
      <arg name="input/image6" value="/sensing/camera/camera6/image_raw"/>
      <arg name="input/image7" value="/sensing/camera/camera7/image_raw"/>
      <arg name="input/image8" value="/sensing/camera/camera8/image_raw"/>
      <arg name="input/pointcloud" value="$(var pointpainting/input/pointcloud)"/>
      <arg name="input/concatenation_info" value="/sensing/lidar/concatenated/pointcloud_info"/>
      <arg name="output/objects" value="$(var pointpainting/output/objects)"/>

      <arg name="model_name" value="$(var lidar_detection_model_name)"/>
      <arg name="model_path" value="$(var data_path)/image_projection_based_fusion"/>
      <arg name="model_param_path" value="$(find-pkg-share autoware_launch_config)/config/perception/object_recognition/detection/lidar_model/$(var lidar_detection_model_name).param.yaml"/>
      <arg name="ml_package_param_path" value="$(var model_path)/$(var lidar_detection_model_name)_ml_package.param.yaml"/>
      <arg name="class_remapper_param_path" value="$(var model_path)/detection_class_remapper.param.yaml"/>
      <arg name="common_param_path" value="$(find-pkg-share autoware_launch_config)/config/perception/object_recognition/detection/image_projection_based_fusion/pointpainting_common.param.yaml"/>
      <arg name="use_pointcloud_container" value="true"/>
      <arg name="pointcloud_container_name" value="/pointcloud_container"/>
    </include>
  </group>

  <!-- Image_segmentation based filter, apply for camera0 only-->
  <group>
    <include file="$(find-pkg-share autoware_image_projection_based_fusion)/launch/segmentation_pointcloud_fusion.launch.py" if="$(var use_image_segmentation_based_filter)">
      <arg name="input/concatenation_info" value="/sensing/lidar/concatenated/pointcloud_info"/>
      <arg name="input/pointcloud" value="$(var segmentation_based_filtered/input/pointcloud)"/>
      <arg name="output/pointcloud" value="$(var segmentation_based_filtered/output/pointcloud)"/>
      <arg name="fusion_camera_ids" value="$[0,2,4]"/>
      <arg name="sync_param_path" value="$(find-pkg-share autoware_launch_config)/config/perception/object_recognition/detection/image_projection_based_fusion/fusion_common.param.yaml"/>
    </include>
  </group>

  <!-- Clustering -->
  <group>
    <push-ros-namespace namespace="clustering"/>
    <group>
      <include file="$(find-pkg-share autoware_euclidean_cluster)/launch/voxel_grid_based_euclidean_cluster.launch.xml">
        <arg name="input_pointcloud" value="$(var euclidean_cluster/input/pointcloud)"/>
        <arg name="output_clusters" value="$(var euclidean_cluster/output/clusters)"/>
        <arg name="use_low_height_cropbox" value="$(var use_low_height_cropbox)"/>
        <arg name="use_pointcloud_container" value="false"/>
        <arg
          name="voxel_grid_based_euclidean_param_path"
          value="$(find-pkg-share autoware_launch_config)/config/perception/object_recognition/detection/clustering/voxel_grid_based_euclidean_cluster.param.yaml"
        />
      </include>
    </group>

    <!-- shape_estimation 1 -->
    <node pkg="autoware_shape_estimation" exec="shape_estimation_node" name="shape_estimation" output="screen">
      <env name="LD_PRELOAD" value="$(var ld_preload_value)"/>
      <remap from="input" to="$(var shape_estimation1/input/clusters)"/>
      <remap from="objects" to="$(var shape_estimation1/output/objects)"/>
      <param name="model_path" value="$(var data_path)/shape_estimation/pointnet.onnx"/>
      <param from="$(find-pkg-share autoware_shape_estimation)/config/shape_estimation.param.yaml" allow_substs="true"/>
    </node>

    <group>
      <push-ros-namespace namespace="camera_lidar_fusion"/>
      <!-- Fusion camera-lidar to classify -->

      <!-- euclidean clustering -->
      <group>
        <include file="$(find-pkg-share autoware_image_projection_based_fusion)/launch/roi_cluster_fusion.launch.xml">
          <arg name="input/rois_number" value="$(var number_of_cameras)"/>
          <arg name="input/rois0" value="/perception/object_recognition/detection/rois0"/>
          <arg name="input/rois1" value="/perception/object_recognition/detection/rois1"/>
          <arg name="input/rois2" value="/perception/object_recognition/detection/rois2"/>
          <arg name="input/rois3" value="/perception/object_recognition/detection/rois3"/>
          <arg name="input/rois4" value="/perception/object_recognition/detection/rois4"/>
          <arg name="input/rois5" value="/perception/object_recognition/detection/rois5"/>
          <arg name="input/rois6" value="/perception/object_recognition/detection/rois6"/>
          <arg name="input/rois7" value="/perception/object_recognition/detection/rois7"/>
          <arg name="input/rois8" value="/perception/object_recognition/detection/rois8"/>
          <arg name="input/camera_info0" value="/sensing/camera/camera0/camera_info"/>
          <arg name="input/camera_info1" value="/sensing/camera/camera1/camera_info"/>
          <arg name="input/camera_info2" value="/sensing/camera/camera2/camera_info"/>
          <arg name="input/camera_info3" value="/sensing/camera/camera3/camera_info"/>
          <arg name="input/camera_info4" value="/sensing/camera/camera4/camera_info"/>
          <arg name="input/camera_info5" value="/sensing/camera/camera5/camera_info"/>
          <arg name="input/camera_info6" value="/sensing/camera/camera6/camera_info"/>
          <arg name="input/camera_info7" value="/sensing/camera/camera7/camera_info"/>
          <arg name="input/camera_info8" value="/sensing/camera/camera8/camera_info"/>
          <arg name="input/image0" value="/sensing/camera/camera0/image_raw"/>
          <arg name="input/image1" value="/sensing/camera/camera1/image_raw"/>
          <arg name="input/image2" value="/sensing/camera/camera2/image_raw"/>
          <arg name="input/image3" value="/sensing/camera/camera3/image_raw"/>
          <arg name="input/image4" value="/sensing/camera/camera4/image_raw"/>
          <arg name="input/image5" value="/sensing/camera/camera5/image_raw"/>
          <arg name="input/image6" value="/sensing/camera/camera6/image_raw"/>
          <arg name="input/image7" value="/sensing/camera/camera7/image_raw"/>
          <arg name="input/image8" value="/sensing/camera/camera8/image_raw"/>
          <arg name="input/concatenation_info" value="/sensing/lidar/concatenated/pointcloud_info"/>
          <arg name="input/clusters" value="$(var roi_cluster_fusion/input/clusters)"/>
          <arg name="output/clusters" value="$(var roi_cluster_fusion/output/clusters)"/>
          <arg name="param_path" value="$(find-pkg-share autoware_launch_config)/config/perception/object_recognition/detection/image_projection_based_fusion/roi_cluster_fusion.param.yaml"/>
        </include>
      </group>

      <!-- low_intensity_cluster_filter -->
      <node pkg="autoware_raindrop_cluster_filter" exec="low_intensity_cluster_filter_node" name="low_intensity_cluster_filter_node" output="screen">
        <env name="LD_PRELOAD" value="$(var ld_preload_value)"/>
        <remap from="input/objects" to="$(var low_intensity_cluster_filter/input/clusters)"/>
        <remap from="output/objects" to="$(var low_intensity_cluster_filter/output/clusters)"/>
        <param name="input_obstacle_pointcloud" value="false"/>
        <param from="$(find-pkg-share autoware_raindrop_cluster_filter)/config/low_intensity_cluster_filter.param.yaml"/>
      </node>

      <node pkg="autoware_shape_estimation" exec="shape_estimation_node" name="shape_estimation" output="screen">
        <env name="LD_PRELOAD" value="$(var ld_preload_value)"/>
        <remap from="input" to="$(var shape_estimation2/input/clusters)"/>
        <remap from="objects" to="$(var shape_estimation2/output/objects)"/>
        <param name="model_path" value="$(var data_path)/shape_estimation/pointnet.onnx"/>
        <param from="$(find-pkg-share autoware_shape_estimation)/config/shape_estimation.param.yaml" allow_substs="true"/>
      </node>

      <!-- convert DynamicObjectsWithFeatureArray to DynamicObjects -->
      <node pkg="autoware_detected_object_feature_remover" exec="detected_object_feature_remover_node" name="detected_object_feature_remover" output="screen">
        <env name="LD_PRELOAD" value="$(var ld_preload_value)"/>
        <remap from="~/input" to="$(var detected_object_feature_remover/input/objects_with_feature)"/>
        <remap from="~/output" to="$(var detected_object_feature_remover/output/objects)"/>
        <param name="run_convex_hull_conversion" value="false"/>
      </node>
    </group>
  </group>
</launch>
