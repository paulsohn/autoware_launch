<?xml version="1.0"?>
<launch>
  <push-ros-namespace namespace="camera_vru"/>

  <!-- parameters -->
  <arg name="rois_ids" default="[0, 1]"/>

  <!-- near range roi based VRU detection -->
  <group>
    <include file="$(find-pkg-share autoware_image_object_locator)/launch/bbox_object_locator.launch.xml">
      <arg name="rois_ids" value="$(var rois_ids)"/>

      <arg name="input/rois0" value="/perception/object_recognition/detection/rois0"/>
      <arg name="input/rois1" value="/perception/object_recognition/detection/rois1"/>
      <arg name="input/rois2" value="/perception/object_recognition/detection/rois2"/>
      <arg name="input/rois3" value="/perception/object_recognition/detection/rois3"/>
      <arg name="input/rois4" value="/perception/object_recognition/detection/rois4"/>
      <arg name="input/rois5" value="/perception/object_recognition/detection/rois5"/>
      <arg name="input/rois6" value="/perception/object_recognition/detection/rois6"/>
      <arg name="input/rois7" value="/perception/object_recognition/detection/rois7"/>

      <arg name="input/camera_info0" value="/sensing/camera/camera0/camera_info"/>
      <arg name="input/camera_info1" value="/sensing/camera/camera1/camera_info"/>
      <arg name="input/camera_info2" value="/sensing/camera/camera2/camera_info"/>
      <arg name="input/camera_info3" value="/sensing/camera/camera3/camera_info"/>
      <arg name="input/camera_info4" value="/sensing/camera/camera4/camera_info"/>
      <arg name="input/camera_info5" value="/sensing/camera/camera5/camera_info"/>
      <arg name="input/camera_info6" value="/sensing/camera/camera6/camera_info"/>
      <arg name="input/camera_info7" value="/sensing/camera/camera7/camera_info"/>

      <arg name="output/rois0/objects" value="roi_detector_objects0"/>
      <arg name="output/rois1/objects" value="roi_detector_objects1"/>
      <arg name="output/rois2/objects" value="roi_detector_objects2"/>
      <arg name="output/rois3/objects" value="roi_detector_objects3"/>
      <arg name="output/rois4/objects" value="roi_detector_objects4"/>
      <arg name="output/rois5/objects" value="roi_detector_objects5"/>
      <arg name="output/rois6/objects" value="roi_detector_objects6"/>
      <arg name="output/rois7/objects" value="roi_detector_objects7"/>

      <arg name="param_path" value="$(find-pkg-share autoware_launch_config)/config/perception/object_recognition/detection/camera_vru_detection/near_range_camera_vru_detector.param.yaml"/>
    </include>
  </group>

  <!-- object merger -->
  <group>
    <include file="$(find-pkg-share autoware_simple_object_merger)/launch/simple_object_merger.launch.xml">
      <arg name="input_topics" value="[roi_detector_objects0,roi_detector_objects1]"/>
      <arg name="output/objects" value="objects"/>
    </include>
  </group>
</launch>
