<?xml version="1.0"?>
<launch>
  <!-- External interfaces -->
  <arg name="node/pointcloud_container"/>
  <arg name="input/pointcloud_map/pointcloud"/>
  <arg name="input/obstacle_segmentation/pointcloud"/>
  <arg name="output/cluster_objects"/>
  <arg name="output/objects"/>

  <!-- Internal interfaces -->
  <let name="euclidean_cluster/input/pointcloud" value="$(var input/pointcloud_map/pointcloud)"/>
  <let name="euclidean_cluster/output/clusters" value="$(var ros_namespace)/clustering/clusters"/>
  <let name="shape_estimation/input/objects" value="$(var ros_namespace)/clustering/clusters"/>
  <let name="shape_estimation/output/objects" value="$(var output/cluster_objects)"/>
  <let name="detected_object_feature_remover/input" value="$(var output/cluster_objects)"/>
  <let name="detected_object_feature_remover/output" value="$(var output/objects)"/>

  <include file="$(find-pkg-share autoware_agnocast_wrapper)/launch/agnocast_env.launch.xml"/>

  <!-- Clustering -->
  <group>
    <push-ros-namespace namespace="clustering"/>
    <group>
      <include file="$(find-pkg-share autoware_euclidean_cluster)/launch/voxel_grid_based_euclidean_cluster.launch.xml">
        <arg name="input_pointcloud" value="$(var euclidean_cluster/input/pointcloud)"/>
        <arg name="output_clusters" value="$(var euclidean_cluster/output/clusters)"/>
        <arg name="use_low_height_cropbox" value="$(var use_low_height_cropbox)"/>
        <arg name="use_pointcloud_container" value="true"/>
        <arg name="pointcloud_container_name" value="$(var node/pointcloud_container)"/>
        <arg
          name="voxel_grid_based_euclidean_param_path"
          value="$(find-pkg-share autoware_launch_config)/config/perception/object_recognition/detection/clustering/voxel_grid_based_euclidean_cluster.param.yaml"
        />
      </include>
    </group>

    <node pkg="autoware_shape_estimation" exec="shape_estimation_node" name="shape_estimation" output="screen">
      <env name="LD_PRELOAD" value="$(var ld_preload_value)"/>
      <remap from="input" to="$(var shape_estimation/input/objects)"/>
      <remap from="objects" to="$(var shape_estimation/output/objects)"/>
      <param name="model_path" value="$(var data_path)/shape_estimation/pointnet.onnx"/>
      <param from="$(find-pkg-share autoware_shape_estimation)/config/shape_estimation.param.yaml" allow_substs="true"/>
    </node>

    <!-- convert DynamicObjectsWithFeatureArray to DynamicObjects -->
    <node pkg="autoware_detected_object_feature_remover" exec="detected_object_feature_remover_node" name="detected_object_feature_remover" output="screen">
      <env name="LD_PRELOAD" value="$(var ld_preload_value)"/>
      <remap from="~/input" to="$(var detected_object_feature_remover/input)"/>
      <remap from="~/output" to="$(var detected_object_feature_remover/output)"/>
      <param name="run_convex_hull_conversion" value="false"/>
    </node>
  </group>
</launch>
