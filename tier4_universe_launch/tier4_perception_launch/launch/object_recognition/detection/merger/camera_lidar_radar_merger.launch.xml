<?xml version="1.0"?>
<launch>
  <!-- Pipeline junctions -->
  <arg name="lidar_detection_model_type"/>
  <arg name="use_irregular_object_detector"/>

  <arg name="input/lidar_ml/objects"/>
  <arg name="input/lidar_rule/objects"/>
  <arg name="input/radar/objects"/>
  <arg name="input/detection_by_tracker/objects"/>
  <arg name="output/objects" default="objects"/>

  <!-- internal interfaces -->
  <let name="radar_objects_fusion/input/objects" value="$(var input/lidar_ml/objects)"/>
  <let name="radar_objects_fusion/input/radars" value="$(var input/radar/objects)"/>
  <let name="radar_objects_fusion/output/objects" value="radar_fusion/objects"/>

  <let name="detected_object_roi_filter/input/objects" value="$(var input/lidar_ml/objects)"/>
  <let name="detected_object_roi_filter/output/objects" value="$(var lidar_detection_model_type)/roi_fusion/objects"/>

  <let name="merger0/input/objects0" value="$(var detected_object_roi_filter/output/objects)"/>
  <let name="merger0/input/objects1" value="/perception/object_recognition/detection/irregular_object/objects"/>
  <let name="merger0/output/objects" value="$(var lidar_detection_model_type)_irregular_object_merger/objects"/>

  <let name="merger1/input/objects0" value="$(var detected_object_roi_filter/output/objects)" unless="$(var use_irregular_object_detector)"/>
  <let name="merger1/input/objects0" value="$(var merger0/output/objects)" if="$(var use_irregular_object_detector)"/>
  <let name="merger1/input/objects1" value="$(var input/lidar_rule/objects)"/>
  <let name="merger1/output/objects" value="$(var lidar_detection_model_type)_roi_cluster_fusion/objects"/>

  <let name="merger2/input/objects0" value="$(var merger1/output/objects)"/>
  <let name="merger2/input/objects1" value="$(var input/detection_by_tracker/objects)"/>
  <let name="merger2/output/objects" value="objects_before_filter"/>

  <let name="filter/input/objects" value="$(var merger2/output/objects)"/>

  <!-- Detected object filter by ROI -->
  <group>
    <include file="$(find-pkg-share autoware_image_projection_based_fusion)/launch/roi_detected_object_fusion.launch.xml">
      <arg name="input/rois_number" value="6"/>
      <arg name="input/rois0" value="/perception/object_recognition/detection/rois0"/>
      <arg name="input/rois1" value="/perception/object_recognition/detection/rois1"/>
      <arg name="input/rois2" value="/perception/object_recognition/detection/rois2"/>
      <arg name="input/rois3" value="/perception/object_recognition/detection/rois3"/>
      <arg name="input/rois4" value="/perception/object_recognition/detection/rois4"/>
      <arg name="input/rois5" value="/perception/object_recognition/detection/rois5"/>
      <arg name="input/camera_info0" value="/sensing/camera/camera0/camera_info"/>
      <arg name="input/camera_info1" value="/sensing/camera/camera1/camera_info"/>
      <arg name="input/camera_info2" value="/sensing/camera/camera2/camera_info"/>
      <arg name="input/camera_info3" value="/sensing/camera/camera3/camera_info"/>
      <arg name="input/camera_info4" value="/sensing/camera/camera4/camera_info"/>
      <arg name="input/camera_info5" value="/sensing/camera/camera5/camera_info"/>
      <arg name="input/image0" value="/sensing/camera/camera0/image_raw"/>
      <arg name="input/image1" value="/sensing/camera/camera1/image_raw"/>
      <arg name="input/image2" value="/sensing/camera/camera2/image_raw"/>
      <arg name="input/image3" value="/sensing/camera/camera3/image_raw"/>
      <arg name="input/image4" value="/sensing/camera/camera4/image_raw"/>
      <arg name="input/image5" value="/sensing/camera/camera5/image_raw"/>
      <arg name="input/concatenation_info" value="/sensing/lidar/concatenated/pointcloud_info"/>
      <arg name="input/objects" value="$(var detected_object_roi_filter/input/objects)"/>
      <arg name="output/objects" value="$(var detected_object_roi_filter/output/objects)"/>
      <arg name="param_path" value="$(find-pkg-share autoware_launch_config)/config/perception/object_recognition/detection/image_projection_based_fusion/roi_detected_object_fusion.param.yaml"/>
    </include>
  </group>

  <!-- merger: irregular_objects + ml_lidar -->
  <group if="$(var use_irregular_object_detector)">
    <node pkg="autoware_simple_object_merger" exec="simple_object_merger_node" name="simple_object_merger" output="screen">
      <remap from="~/output/objects" to="$(var merger0/output/objects)"/>
      <param from="$(find-pkg-share autoware_simple_object_merger)/config/simple_object_merger.param.yaml" allow_substs="true"/>
      <param name="update_rate_hz" value="10.0"/>
      <param name="input_topics" value="[$(var merger0/input/objects0),$(var merger0/input/objects1)]"/>
    </node>
  </group>

  <let name="data_association_matrix_path" value="$(find-pkg-share autoware_launch_config)/config/perception/object_recognition/detection/object_merger/data_association_matrix.param.yaml"/>
  <let name="distance_threshold_list_path" value="$(find-pkg-share autoware_launch_config)/config/perception/object_recognition/detection/object_merger/overlapped_judge.param.yaml"/>

  <!-- 1st merger -->
  <group>
    <include file="$(find-pkg-share autoware_object_merger)/launch/object_association_merger.launch.xml">
      <arg name="node_name" value="object_association_merger_alpha"/>
      <arg name="input/object0" value="$(var merger1/input/objects0)"/>
      <arg name="input/object1" value="$(var merger1/input/objects1)"/>
      <arg name="output/object" value="$(var merger1/output/objects)"/>
      <arg name="priority_mode" value="0"/>
      <arg name="data_association_matrix_path" value="$(var data_association_matrix_path)"/>
      <arg name="distance_threshold_list_path" value="$(var distance_threshold_list_path)"/>
      <arg
        name="object_association_merger_param_path"
        value="$(find-pkg-share autoware_launch_config)/config/perception/object_recognition/detection/object_merger/ml_camera_lidar_object_association_merger.param.yaml"
      />
    </include>
  </group>

  <!-- 2nd merger: + detection_by_tracker -->
  <group>
    <include file="$(find-pkg-share autoware_object_merger)/launch/object_association_merger.launch.xml">
      <arg name="node_name" value="object_association_merger_beta"/>
      <arg name="input/object0" value="$(var merger2/input/objects0)"/>
      <arg name="input/object1" value="$(var merger2/input/objects1)"/>
      <arg name="output/object" value="$(var merger2/output/objects)"/>
      <arg name="priority_mode" value="0"/>
      <arg name="data_association_matrix_path" value="$(var data_association_matrix_path)"/>
      <arg name="distance_threshold_list_path" value="$(var distance_threshold_list_path)"/>
    </include>
  </group>

  <!-- Filter -->
  <group>
    <include file="$(find-pkg-share autoware_detected_object_validation)/launch/object_lanelet_filter.launch.xml">
      <arg name="input/object" value="$(var filter/input/objects)"/>
      <arg name="output/object" value="$(var output/objects)"/>
      <arg name="filtering_range_param" value="$(find-pkg-share autoware_launch_config)/config/perception/object_recognition/detection/object_filter/object_lanelet_filter.param.yaml"/>
    </include>
  </group>
</launch>
