<?xml version="1.0"?>
<launch>
  <arg name="lidar_detection_model_type" default="centerpoint"/>

  <!-- Multi object tracking -->
  <include file="$(find-pkg-share autoware_multi_object_tracker)/launch/multi_object_tracker.launch.xml">
    <arg name="input/detection01/channel" value="lidar_$(var lidar_detection_model_type)"/>
    <arg name="input/detection01/objects" value="/perception/object_recognition/detection/$(var lidar_detection_model_type)/validation/objects"/>
    <arg name="input/detection02/channel" value="none"/>
    <arg name="input/detection02/objects" value="/perception/object_recognition/detection/centerpoint_short_range/objects"/>
    <arg name="input/detection03/channel" value="detection_by_tracker"/>
    <arg name="input/detection03/objects" value="/perception/object_recognition/detection/detection_by_tracker/objects"/>
    <arg name="input/detection04/channel" value="radar"/>
    <arg name="input/detection04/objects" value="/perception/object_recognition/detection/radar/far_objects"/>

    <arg name="output/objects" value="/perception/object_recognition/tracking/objects"/>
    <arg name="output/merged_objects" value="/perception/object_recognition/tracking/merged_objects"/>
    <arg name="data_association_matrix_path" value="$(find-pkg-share autoware_launch_config)/config/perception/object_recognition/tracking/multi_object_tracker/data_association_matrix.param.yaml"/>
    <arg name="input_channels_path" value="$(find-pkg-share autoware_launch_config)/config/perception/object_recognition/tracking/multi_object_tracker/input_channels.param.yaml"/>
    <arg name="tracker_setting_path" value="$(find-pkg-share autoware_launch_config)/config/perception/object_recognition/tracking/multi_object_tracker/multi_object_tracker_node.param.yaml"/>
    <arg name="publish_merged_objects" value="false"/>
  </include>
</launch>
