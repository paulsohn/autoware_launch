<?xml version="1.0"?>
<launch>
  <arg name="lidar_detection_model" default="centerpoint"/>

  <!-- ML model parameters -->
  <let name="lidar_detection_model_type" value="$(eval &quot;'$(var lidar_detection_model)'.split('/')[0]&quot;)"/>
  <let name="lidar_detection_model_name" value="$(eval &quot;'$(var lidar_detection_model)'.split('/')[1] if '/' in '$(var lidar_detection_model)' else ''&quot;)"/>
  <let name="lidar_detection_model_name" value="bevfusion_lidar" if="$(eval &quot;'bevfusion'=='$(var lidar_detection_model_type)' and ''=='$(var lidar_detection_model_name)'&quot;)"/>
  <let name="lidar_detection_model_name" value="transfusion" if="$(eval &quot;'transfusion'=='$(var lidar_detection_model_type)' and ''=='$(var lidar_detection_model_name)'&quot;)"/>
  <let name="lidar_detection_model_name" value="centerpoint_tiny" if="$(eval &quot;'centerpoint'=='$(var lidar_detection_model_type)' and ''=='$(var lidar_detection_model_name)'&quot;)"/>
  <let name="lidar_detection_model_name" value="pointpainting" if="$(eval &quot;'pointpainting'=='$(var lidar_detection_model_type)' and ''=='$(var lidar_detection_model_name)'&quot;)"/>

  <!-- Common parameters -->
  <arg name="mode" default="camera_lidar_fusion">
    <choice value="camera"/>
    <choice value="camera_lidar_radar_fusion"/>
    <choice value="camera_lidar_fusion"/>
    <choice value="lidar_radar_fusion"/>
    <choice value="lidar"/>
  </arg>
  <arg name="data_path" default="$(env HOME)/autoware_data/ml_models" description="packages data and artifacts directory path"/>

  <!-- traffic light recognition options to switch launch function/module -->
  <arg name="traffic_light_recognition/camera_namespaces" default="[camera6, camera7]"/>
  <arg name="traffic_light_recognition/use_high_accuracy_detection" default="true"/>

  <!-- Perception module -->
  <group>
    <push-ros-namespace namespace="perception"/>

    <!-- Object segmentation module -->
    <group>
      <push-ros-namespace namespace="obstacle_segmentation"/>
      <include file="$(find-pkg-share tier4_perception_launch)/launch/obstacle_segmentation/ground_segmentation/ground_segmentation.launch.py">
        <arg name="use_intra_process" value="true"/>
        <arg name="use_multithread" value="true"/>
      </include>
    </group>

    <!-- Occupancy grid map module -->
    <group>
      <push-ros-namespace namespace="occupancy_grid_map"/>
      <include file="$(find-pkg-share tier4_perception_launch)/launch/occupancy_grid_map/probabilistic_occupancy_grid_map.launch.xml">
        <arg name="occupancy_grid_map/method" value="pointcloud_based"/>
      </include>
    </group>

    <!-- Object recognition module -->
    <group>
      <push-ros-namespace namespace="object_recognition"/>
      <!-- Detection module -->
      <group>
        <push-ros-namespace namespace="detection"/>
        <include file="$(find-pkg-share tier4_perception_launch)/launch/object_recognition/detection/detection.launch.xml">
          <arg name="mode" value="$(var mode)"/>
          <arg name="lidar_detection_model_type" value="$(var lidar_detection_model_type)"/>
          <arg name="lidar_detection_model_name" value="$(var lidar_detection_model_name)"/>
        </include>
      </group>

      <!-- Tracking module -->
      <group>
        <push-ros-namespace namespace="tracking"/>
        <include file="$(find-pkg-share tier4_perception_launch)/launch/object_recognition/tracking/tracking.launch.xml">
          <arg name="mode" value="$(var mode)"/>
          <arg name="lidar_detection_model_type" value="$(var lidar_detection_model_type)"/>
        </include>
      </group>

      <!-- Prediction module -->
      <group>
        <push-ros-namespace namespace="prediction"/>
        <include file="$(find-pkg-share tier4_perception_launch)/launch/object_recognition/prediction/prediction.launch.xml"/>
      </group>
    </group>

    <!-- Traffic light module -->
    <group>
      <push-ros-namespace namespace="traffic_light_recognition"/>
      <include file="$(find-pkg-share tier4_perception_launch)/launch/traffic_light_recognition/traffic_light.launch.xml">
        <arg name="camera_namespaces" value="$(var traffic_light_recognition/camera_namespaces)"/>
        <arg name="fusion_only" value="$(var traffic_light_recognition/fusion_only)"/>
        <arg name="use_high_accuracy_detection" value="$(var traffic_light_recognition/use_high_accuracy_detection)"/>
      </include>
    </group>
  </group>

  <!-- perception analytics publisher-->
  <group>
    <include file="$(find-pkg-share autoware_perception_online_evaluator)/launch/perception_analytics_publisher.launch.xml"/>
  </group>
</launch>
